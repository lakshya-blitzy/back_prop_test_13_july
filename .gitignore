*.egg-info/

# Virtual environments
.venv/
venv/

# Test and coverage caches
.pytest_cache/
.coverage

# Flask instance folder
instance/

# Generated test artifacts (cucumber-reports.html, cucumber.json, rerun.txt,
# cucumber/ tree and the .workers/ intermediates)
target/
