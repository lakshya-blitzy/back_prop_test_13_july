# =============================================================================
# .env.example - copy to `.env` (git-ignored) and adjust as needed.
#
#   cp .env.example .env
#
# Configuration precedence (highest wins):
#   explicit constructor argument
#     -> environment variable
#       -> .env file
#         -> configuration.properties          (git-ignored runtime file)
#           -> hard-coded default in app/config.py
#
# EVERY default below is the value carried over from the source project, with
# the source construct named in the comment. Values are data, not opportunities
# to modernise: do not "fix" them here.
# =============================================================================

# --- Flask application -------------------------------------------------------
# Config profile selected by create_app(config_name): development | testing | production
APP_CONFIG=development
FLASK_APP=wsgi.py
FLASK_DEBUG=0
APP_HOST=0.0.0.0
APP_PORT=8000
# Only used for Flask session signing; no secret is stored in the repository.
SECRET_KEY=change-me-in-production

# --- Stage 'Clone code' ------------------------------------------------------
# Default = the URL the CI pipeline actually clones (Jenkins: git '<url>').
CLONE_URL=https://github.com/BalamiRR/Upgenix-QA.git
# The README "Framework set up" section documents a DIFFERENT repository. Both
# values are retained deliberately; the pipeline value above is the default.
CLONE_URL_DOCUMENTED=https://github.com/BalamiRR/Testinium-QA.git
CLONE_BRANCH=main
CLONE_DIR=workspace
CLONE_TIMEOUT_SECONDS=300

# --- Stage 'Run tests' -------------------------------------------------------
# Port of @CucumberOptions tags = "@LogOut" (pytest-bdd strips the leading @).
# No scenario carries this tag, so the default run selects ZERO scenarios and
# must still be reported as SUCCESS. Set to an empty string to run everything.
TAG_EXPRESSION=LogOut
# Port of <testFailureIgnore>true</testFailureIgnore>: pytest exit codes 1 (test
# failures) and 5 (nothing selected) are NOT treated as pipeline failures.
IGNORE_TEST_FAILURES=true
# Port of <parallel>methods</parallel> + <useUnlimitedThreads>true</useUnlimitedThreads>.
# `logical` requires psutil (declared in requirements-test.txt).
PYTEST_WORKERS=logical
# Port of the commented-out <!-- <threadCount>4</threadCount> --> tuning value.
# Preserved here DISABLED, exactly as in pom.xml. Uncomment to pin 4 workers.
# PYTEST_WORKERS=4
TEST_TIMEOUT_SECONDS=1800

# --- Stage 'Generate report' -------------------------------------------------
# The six cucumber-publisher thresholds. -1 means "no threshold" (never gates).
REPORT_FAILED_FEATURES_NUMBER=-1
REPORT_FAILED_SCENARIOS_NUMBER=-1
REPORT_FAILED_STEPS_NUMBER=-1
REPORT_PENDING_STEPS_NUMBER=-1
REPORT_SKIPPED_STEPS_NUMBER=-1
REPORT_UNDEFINED_STEPS_NUMBER=-1
REPORT_SORTING_METHOD=ALPHABETICAL
# Preserved verbatim AS DATA (it is the publisher's fileIncludePattern, not a
# transformation pattern) - do not rewrite.
REPORT_FILE_INCLUDE_PATTERN=**/*.json

# --- Artifact layout (Java-flavoured name retained on purpose so the CI
#     publisher glob '**/*.json' keeps working unchanged) ---------------------
TARGET_DIR=target
CUCUMBER_JSON_PATH=target/cucumber.json
CUCUMBER_HTML_PATH=target/cucumber-reports.html
RERUN_TXT_PATH=target/rerun.txt
PRETTY_REPORTS_DIR=target/cucumber
SCREENSHOTS_DIR=target/screenshots
ERROR_SHOTS_DIR=target/error-shots
SUREFIRE_REPORTS_DIR=target/surefire-reports

# --- Screen shots / error shots (README: "generate screen shots for your tests
#     if you enable it ... error shots for your failed test cases") -----------
SCREENSHOTS_ENABLED=false
ERROR_SHOTS_ENABLED=true

# --- Runtime configuration file (git-ignored; template committed as
#     configuration.properties.example). Absence must degrade gracefully. -----
CONFIGURATION_PROPERTIES_PATH=configuration.properties

# --- Browser automation (Selenium) ------------------------------------------
BROWSER=chrome
HEADLESS=true
# Selenium 4 resolves drivers itself (Selenium Manager); webdriver-manager is
# retained as the one-to-one counterpart of io.github.bonigarcia:webdrivermanager.
DRIVER_MANAGER=selenium-manager
IMPLICIT_WAIT_SECONDS=10
EXPLICIT_WAIT_SECONDS=30
PAGE_LOAD_TIMEOUT_SECONDS=60
# Base URL of the EXTERNAL application under test. It is not reachable from CI,
# so browser-driven scenarios cannot run end to end here (documented limitation).
BASE_URL=

# --- Logging (the repository already ignores *.log) --------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/testinium-qa.log

# --- Multi-instance / parallel-clone support ---------------------------------
# Shifts host port and docker compose project name: port = 8000 + CLONE_INDEX.
CLONE_INDEX=0
